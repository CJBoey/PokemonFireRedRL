+#if defined(PORTABLE) && defined(PN_MIRROR_SECTIONS)
+// fireredsim (mirror layout, docs/MIRROR_LAYOUT.md): every RAM variable is put
+// at its ROM address by a generated linker script (tools/mirror/gen_ld.py), so
+// each one needs an input section of its own. -fdata-sections does not split
+// variables with an explicit section attribute; __COUNTER__ makes the names
+// unique within the file (game/native/mirror_sections.py then renames them to
+// .mirror.<ewram|iwram>.<object>.<variable>). Only the section names change:
+// the layout audit (tools/layout_audit) reads CPPFLAGS without
+// PN_MIRROR_SECTIONS and measures the classic sections.
+#define PN_SECTION_STR2(x) #x
