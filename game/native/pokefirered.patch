diff --git a/src/agb_flash_mx.c b/src/agb_flash_mx.c
index b4f710f..2388593 100644
--- a/src/agb_flash_mx.c
+++ b/src/agb_flash_mx.c
@@ -62,12 +62,18 @@ u16 EraseFlashChip_MX(void)
 
     REG_WAITCNT = (REG_WAITCNT & ~WAITCNT_SRAM_MASK) | gFlash->wait[0];
 
+#ifdef PORTABLE
+    // Chip erase command sequence; the flash model erases instantly and the
+    // status polling below then succeeds at once.
+    Port_FlashEraseChip();
+#else
     FLASH_WRITE(0x5555, 0xAA);
     FLASH_WRITE(0x2AAA, 0x55);
     FLASH_WRITE(0x5555, 0x80);
     FLASH_WRITE(0x5555, 0xAA);
     FLASH_WRITE(0x2AAA, 0x55);
     FLASH_WRITE(0x5555, 0x10);
+#endif
 
     SetReadFlash1(readFlash1Buffer);
 
@@ -98,12 +104,17 @@ try_erase:
 
     addr = FLASH_BASE + (sectorNum << gFlash->sector.shift);
 
+#ifdef PORTABLE
+    // Sector erase command sequence (last write: 0x30 to the sector address).
+    Port_FlashEraseSector(addr);
+#else
     FLASH_WRITE(0x5555, 0xAA);
     FLASH_WRITE(0x2AAA, 0x55);
     FLASH_WRITE(0x5555, 0x80);
     FLASH_WRITE(0x5555, 0xAA);
     FLASH_WRITE(0x2AAA, 0x55);
     *addr = 0x30;
+#endif
 
     SetReadFlash1(readFlash1Buffer);
 
@@ -139,20 +150,29 @@ u16 ProgramFlashByte_MX(u16 sectorNum, u32 offset, u8 data)
 
     REG_WAITCNT = (REG_WAITCNT & ~WAITCNT_SRAM_MASK) | gFlash->wait[0];
 
+#ifdef PORTABLE
+    // Byte program command sequence (the chip can only clear bits).
+    Port_FlashProgramByte(addr, data);
+#else
     FLASH_WRITE(0x5555, 0xAA);
     FLASH_WRITE(0x2AAA, 0x55);
     FLASH_WRITE(0x5555, 0xA0);
     *addr = data;
+#endif
 
     return WaitForFlashWrite(1, addr, data);
 }
 
 static u16 ProgramByte(u8 *src, u8 *dest)
 {
+#ifdef PORTABLE
+    Port_FlashProgramByte(dest, *src);
+#else
     FLASH_WRITE(0x5555, 0xAA);
     FLASH_WRITE(0x2AAA, 0x55);
     FLASH_WRITE(0x5555, 0xA0);
     *dest = *src;
+#endif
 
