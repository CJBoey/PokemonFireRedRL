 void FreeSpriteTiles(struct Sprite *sprite)
 {
+#ifdef PORTABLE
+    // Retail also runs this for sprite == NULL (DestroySpriteAndFreeResources(NULL),
+    // e.g. PokeSum_CreateMonMarkingsSprite when the summary screen opens). The
+    // template pointer then comes from the BIOS region (BIOS open bus, emulated
+    // by platform/memfault.c) and the tag is read through it from unmapped
+    // memory: the CPU open bus, i.e. the Thumb opcode two instructions after
+    // the LDRH at ROM 0x080077B0 (0x4281 at 0x080077B4).
+    u16 tag = Port_LoadWithOpenBus(&sprite->template->tileTag, 2, 0x4281);
+    if (tag != TAG_NONE)
+        FreeSpriteTilesByTag(tag);
+#else
     if (sprite->template->tileTag != TAG_NONE)
         FreeSpriteTilesByTag(sprite->template->tileTag);
+#endif
 }
 
 void FreeSpritePalette(struct Sprite *sprite)
 {
+#ifdef PORTABLE
+    // As FreeSpriteTiles: LDRH at ROM 0x080077CC, open bus = 0xF92F (the second
+    // half of the BL at 0x080077CE).
+    FreeSpritePaletteByTag(Port_LoadWithOpenBus(&sprite->template->paletteTag, 2, 0xF92F));
+#else
     FreeSpritePaletteByTag(sprite->template->paletteTag);
+#endif
 }
 
 void FreeSpriteOamMatrix(struct Sprite *sprite)
