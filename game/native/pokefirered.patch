+static u16 CallSpecialForResult(u16 (*func)(void))
+{
+    u32 i;
+    for (i = 0; i < NELEMS(sNarrowSpecials); i++)
+        if (sNarrowSpecials[i] == func)
+            return ((u8 (*)(void))func)();
+    return func();
