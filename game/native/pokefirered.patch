+#ifndef PORTABLE
 #define FLASH_BASE ((u8 *)0xE000000)
-
+#else
+// fireredsim: the whole 128 KB flash chip is plain memory at 0x0E000000
+// (platform/flash.c, mirror layout): bank 0 at 0x0E000000, bank 1 at
+// 0x0E010000. The GBA maps one 64 KB bank at a time at 0x0E000000;
+// gPortFlashBank is the bank selected by the last SwitchFlashBank().
+extern unsigned char gPortFlashBank;
+#define FLASH_BASE ((u8 *)0xE000000 + ((u32)gPortFlashBank << 16))
+// Flash chip commands are executed by platform/flash.c (see the PORTABLE
+// sections of agb_flash*.c); these replace the chip's command interface.
+u16 Port_FlashReadId(void);
+void Port_FlashEraseChip(void);
+void Port_FlashEraseSector(u8 *sectorAddr);
+void Port_FlashProgramByte(u8 *addr, u8 data);
+#endif
+
+#ifndef PORTABLE
 #define FLASH_WRITE(addr, data) ((*(vu8 *)(FLASH_BASE + (addr))) = (data))
+#else
+// fireredsim: command writes go to the flash chip model (bank switch, reset).
+void Port_FlashCommand(u32 addr, u8 data);
+#define FLASH_WRITE(addr, data) Port_FlashCommand((addr), (data))
+#endif
 
