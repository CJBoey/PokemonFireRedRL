+#define IWRAM_DATA __attribute__((section("iwram_data." PN_SECTION_STR(__COUNTER__))))
+#define EWRAM_DATA __attribute__((section("ewram_data." PN_SECTION_STR(__COUNTER__))))
+#define COMMON_DATA __attribute__((section("common_data." PN_SECTION_STR(__COUNTER__))))
+#else
 #if defined(__APPLE__)
