# fireredsim: native i386 (ILP32) build of pokefirered, FIRERED / REVISION 0 / ENGLISH.
#
#   make -C game -f Makefile.native -j32 [OBJ_DIR=/abs/or/game-relative/dir]
#
# Produces, below $(OBJ_DIR) (default build/native; the root CMakeLists.txt passes
# <cmake build dir>/game-native so that every CMake build directory has its own
# objects and archives):
#   libfirered.a   every game object (src/*.c, data/*.s, songs)
#   libplatform.a  the hardware replacements in ../platform
#   mirror.ld      linker script fragment of the mirror memory layout
#                  (docs/MIRROR_LAYOUT.md), generated by
#                  ../tools/mirror/gen_ld.py: every game RAM variable at
#                  its retail ROM address (+ mirror_placement.tsv)
# Only these objects and archives are per OBJ_DIR. The asset pipeline's outputs
# (graphics *.4bpp/*.gbapal/*.lz, generated data headers/inc files, tools/*) are
# written into the source tree and shared by all builds; they are deterministic.
#
# Derived from pret's Makefile: the same tools, the same graphics/map/json/audio
# rules (included from the *_rules.mk files) and the same cpp|preproc pipeline,
# but C goes through gcc -m32 and data .s files go through native/as_x86.py,
# which converts ARM GAS syntax and assembles with as --32. Every object is then
# post-processed by native/mirror_sections.py, which gives each RAM variable's
# section a unique name (.mirror.<ewram|iwram>.<object>.<variable>) and moves
# native-only platform state to .pnstate.
#
# The ARM-only sources (src/crt0.s, src/libagbsyscall.s, src/libgcnmultiboot.s,
# src/m4a_1.s, src/rom_header.s) are not built; ../platform replaces them.

include config.mk

MODERN := 1
BUILD_NAME := native
# Object directory (override on the make command line: OBJ_DIR=...; relative paths are
# relative to game/). Everything the build produces for ONE configuration lives here.
OBJ_DIR := build/native
OBJ_ROOT := $(abspath $(OBJ_DIR))
# tools/mirror/layout.py and native/mirror_sections.py derive an object's section tag
# (src_main, platform_hw, ...) from its path below this directory.
export PN_OBJ_ROOT := $(OBJ_ROOT)

SHELL := bash -o pipefail
MAKEFLAGS += --no-print-directory

PYTHON  := python3
CC      := gcc -m32
CPP     := gcc -m32 -E
AS      := $(PYTHON) native/as_x86.py
AR      := ar
MIRROR_SECTIONS := $(PYTHON) native/mirror_sections.py
GEN_LD  := $(PYTHON) ../tools/mirror/gen_ld.py
ROM_SYMBOLS := ../reference/rom_symbols_detailed.tsv

PLATFORM_DIR := ../platform

# ---------------------------------------------------------------------------
# Flags
#
# Defines: exactly the retail build's (FIRERED, REVISION=0, ENGLISH; pret's
# Makefile does not define NDEBUG for this build, so the retail asserts stay
# compiled in) plus MODERN=1 PORTABLE NONMATCHING UBFIX. config.h no longer
# forces BUGFIX under PORTABLE (BUGFIX changes retail gameplay).
# gba/portable_abi.h is force-included: it applies the ARM APCS rule "every
# struct/union is 4-aligned and padded to a multiple of 4" to game structs.
GAME_DEFS := -D$(GAME_VERSION) -DREVISION=$(GAME_REVISION) -D$(GAME_LANGUAGE) -DMODERN=$(MODERN) \
             -DPORTABLE -DNONMATCHING -DUBFIX
CPPFLAGS := -iquote include -Wno-trigraphs $(GAME_DEFS) -include include/gba/portable_abi.h \
            -Ui386 -Ulinux -Uunix -funsigned-char -U_FORTIFY_SOURCE

# ARCHITECTURE.md section 1.2 flags (+ -fno-toplevel-reorder as in pret's MODERN
# build: save blocks and their *_DMA slack arrays must stay adjacent).
# No -malign-double: agbcc (old APCS) 4-aligns 64-bit types (layout audit).
# -funsigned-char is also in CPPFLAGS so that __CHAR_UNSIGNED__ is defined
# while preprocessing (<limits.h> CHAR_MIN/CHAR_MAX).
# -malign-data=abi: no extra 32-byte alignment of large arrays, so variables of
# one file sit at the same relative offsets as in the ROM (agbcc packs them at
# natural alignment); retail out-of-bounds writes then hit the same neighbours
# (reference/layout_report.md section 5b).
# -fno-stack-protector, -U_FORTIFY_SOURCE: game code runs on a stack inside the
# environment's state (.pnstate, platform/frame.c); the distribution default
# stack protector would write the per-process random canary into it and call
# into libc.
#
# Build options (set by CMakeLists.txt from PN_GAME_OPT / PN_GAME_TUNE / PN_PGO /
# PN_STACK_GUARD; README.md section 3, docs/BENCHMARKS.md "Compiler flags"). The
# defaults are the reference build. They change code generation only, never the
# layout- or semantics-relevant flags above (tools/layout_audit reads the defaults):
#   PN_OPT           optimisation level of game + platform code (-O2; PN_FAST: -O3)
#   PN_TUNE          extra code-generation flags (-march=..., PGO: -fprofile-generate /
#                    -fprofile-use ..., see tools/pgo_build.sh)
#   PN_PLATFORM_DEFS defines for platform code only (-DPN_STACK_GUARD=0)
PN_OPT ?= -O2
PN_TUNE ?=
PN_PLATFORM_DEFS ?=
ARCH_CFLAGS := $(PN_OPT) -msse2 -mfpmath=sse -malign-data=abi -funsigned-char -fwrapv \
               -fno-strict-aliasing -fno-delete-null-pointer-checks \
               -fno-aggressive-loop-optimizations -fno-common -fno-pic -fno-builtin \
               -fno-toplevel-reorder -fno-stack-protector -g $(PN_TUNE)
# Game code warnings are allowed (ARCHITECTURE.md rule 9); these are the
# 32-bit/GBA idioms the decomp uses everywhere.
GAME_WARN := -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-pointer-to-int-cast \
             -Wno-int-to-pointer-cast -Wno-address-of-packed-member -Wno-div-by-zero \
             -Wno-builtin-declaration-mismatch -Wno-attributes -Wno-multichar
CFLAGS := $(ARCH_CFLAGS) $(GAME_WARN)
# Game headers trigger -Wpacked-not-aligned (packed union in TextPrinter) and
# -Wignored-qualifiers (overworld.h); new platform code is otherwise warning-clean.
PLATFORM_CFLAGS := $(ARCH_CFLAGS) $(PN_PLATFORM_DEFS) -Wall -Wextra -Werror -Wno-unused-parameter -Wno-packed-not-aligned -Wno-ignored-qualifiers -I $(PLATFORM_DIR)

# Mirror memory layout (docs/MIRROR_LAYOUT.md): one input section per variable
# (-fdata-sections; PN_MIRROR_SECTIONS gives EWRAM_DATA/IWRAM_DATA/COMMON_DATA
# variables unique section names, gba/defines.h) so that tools/mirror/gen_ld.py
# can put each at its ROM address. Kept out of CPPFLAGS/CFLAGS on purpose: the
# layout audit (tools/layout_audit) reads those and measures type layout and
# the intra-file placement in the classic sections, which these flags do not
# change; absolute addresses are checked by tools/mirror/check_addresses.py.
MIRROR_CPPFLAGS := -DPN_MIRROR_SECTIONS
MIRROR_CFLAGS := -fdata-sections

ASFLAGS := --defsym $(GAME_VERSION)=1 --defsym REVISION=$(GAME_REVISION) --defsym $(GAME_LANGUAGE)=1 \
           --defsym MODERN=$(MODERN) --defsym PORTABLE=1 --defsym UBFIX=1

INCLUDE_DIRS := include
INCLUDE_CPP_ARGS := $(INCLUDE_DIRS:%=-iquote %)
INCLUDE_SCANINC_ARGS := $(INCLUDE_DIRS:%=-I %)

# ---------------------------------------------------------------------------
# Tools (host, 64-bit) and generated sources, exactly as pret does it.
AUTO_GEN_TARGETS :=
include make_tools.mk
GFX       := $(TOOLS_DIR)/gbagfx/gbagfx$(EXE)
WAV2AGB   := $(TOOLS_DIR)/wav2agb/wav2agb$(EXE)
MID       := $(TOOLS_DIR)/mid2agb/mid2agb$(EXE)
SCANINC   := $(TOOLS_DIR)/scaninc/scaninc$(EXE)
PREPROC   := $(TOOLS_DIR)/preproc/preproc$(EXE)
RAMSCRGEN := $(TOOLS_DIR)/ramscrgen/ramscrgen$(EXE)
FIX       := $(TOOLS_DIR)/gbafix/gbafix$(EXE)
MAPJSON   := $(TOOLS_DIR)/mapjson/mapjson$(EXE)
JSONPROC  := $(TOOLS_DIR)/jsonproc/jsonproc$(EXE)

C_SUBDIR = src
DATA_SRC_SUBDIR = src/data
DATA_ASM_SUBDIR = data
SONG_SUBDIR = sound/songs
MID_SUBDIR = sound/songs/midi

C_BUILDDIR = $(OBJ_DIR)/$(C_SUBDIR)
DATA_ASM_BUILDDIR = $(OBJ_DIR)/$(DATA_ASM_SUBDIR)
SONG_BUILDDIR = $(OBJ_DIR)/$(SONG_SUBDIR)
MID_BUILDDIR = $(OBJ_DIR)/$(MID_SUBDIR)
PLATFORM_BUILDDIR = $(OBJ_DIR)/platform

.SUFFIXES:
.SECONDARY:
.DELETE_ON_ERROR:

RULES_NO_SCAN += clean tidy generated clean-generated
.PHONY: all libs clean tidy generated clean-generated check-data
.PHONY: $(RULES_NO_SCAN)

NODEP ?= 0
SETUP_PREREQS ?= 1
ifneq (,$(MAKECMDGOALS))
  ifeq (,$(filter-out $(RULES_NO_SCAN),$(MAKECMDGOALS)))
    NODEP := 1
    SETUP_PREREQS := 0
  endif
endif

.SHELLSTATUS ?= 0
ifeq ($(SETUP_PREREQS),1)
  $(foreach line, $(shell $(MAKE) -f make_tools.mk | sed "s/ /__SPACE__/g"), $(info $(subst __SPACE__, ,$(line))))
  ifneq ($(.SHELLSTATUS),0)
    $(error Errors occurred while building tools. See error messages above for more details)
  endif
  $(foreach line, $(shell $(MAKE) -f Makefile.native OBJ_DIR=$(OBJ_DIR) generated | sed "s/ /__SPACE__/g"), $(info $(subst __SPACE__, ,$(line))))
  ifneq ($(.SHELLSTATUS),0)
    $(error Errors occurred while generating map-related sources. See error messages above for more details)
  endif
endif

# ---------------------------------------------------------------------------
# Sources
C_SRCS_IN := $(wildcard $(C_SUBDIR)/*.c $(C_SUBDIR)/*/*.c $(C_SUBDIR)/*/*/*.c)
C_SRCS := $(foreach src,$(C_SRCS_IN),$(if $(findstring .inc.c,$(src)),,$(src)))
C_OBJS := $(patsubst $(C_SUBDIR)/%.c,$(C_BUILDDIR)/%.o,$(C_SRCS))

REGULAR_DATA_ASM_SRCS := $(filter-out $(DATA_ASM_SUBDIR)/maps.s $(DATA_ASM_SUBDIR)/map_events.s, $(wildcard $(DATA_ASM_SUBDIR)/*.s))
DATA_ASM_SRCS := $(wildcard $(DATA_ASM_SUBDIR)/*.s)
DATA_ASM_OBJS := $(patsubst $(DATA_ASM_SUBDIR)/%.s,$(DATA_ASM_BUILDDIR)/%.o,$(DATA_ASM_SRCS))

SONG_SRCS := $(wildcard $(SONG_SUBDIR)/*.s)
SONG_OBJS := $(patsubst $(SONG_SUBDIR)/%.s,$(SONG_BUILDDIR)/%.o,$(SONG_SRCS))

MID_SRCS := $(wildcard $(MID_SUBDIR)/*.mid)
MID_OBJS := $(patsubst $(MID_SUBDIR)/%.mid,$(MID_BUILDDIR)/%.o,$(MID_SRCS))

GAME_OBJS := $(C_OBJS) $(DATA_ASM_OBJS) $(SONG_OBJS) $(MID_OBJS)

PLATFORM_SRCS := $(wildcard $(PLATFORM_DIR)/*.c)
PLATFORM_OBJS := $(patsubst $(PLATFORM_DIR)/%.c,$(PLATFORM_BUILDDIR)/%.o,$(PLATFORM_SRCS))

SUBDIRS := $(sort $(dir $(GAME_OBJS) $(PLATFORM_OBJS)))
$(shell mkdir -p $(SUBDIRS))

LIBFIRERED  := $(OBJ_DIR)/libfirered.a
LIBPLATFORM := $(OBJ_DIR)/libplatform.a
MIRROR_LD   := $(OBJ_DIR)/mirror.ld
MIRROR_PLACEMENT := $(OBJ_DIR)/mirror_placement.tsv

all: libs
libs: $(LIBFIRERED) $(LIBPLATFORM) $(MIRROR_LD)

# ---------------------------------------------------------------------------
# pret's asset rules (graphics, tilesets, maps, json, audio).
include graphics_file_rules.mk
include tileset_rules.mk
include map_data_rules.mk
include spritesheet_rules.mk
include json_data_rules.mk
include audio_rules.mk

generated: $(AUTO_GEN_TARGETS)
	@:

%.s:   ;
%.png: ;
%.pal: ;
%.wav: ;

%.1bpp:   %.png  ; $(GFX) $< $@
%.4bpp:   %.png  ; $(GFX) $< $@
%.8bpp:   %.png  ; $(GFX) $< $@
%.gbapal: %.pal  ; $(GFX) $< $@
%.gbapal: %.png  ; $(GFX) $< $@
%.lz:     %      ; $(GFX) $< $@
%.rl:     %      ; $(GFX) $< $@

clean-generated:
	@rm -f $(AUTO_GEN_TARGETS)

tidy:
	rm -rf $(OBJ_DIR)

clean: tidy

# ---------------------------------------------------------------------------
# C (game)
$(C_BUILDDIR)/%.o: $(C_SUBDIR)/%.c
	@echo "cc $<"
	@$(CPP) $(CPPFLAGS) $(MIRROR_CPPFLAGS) $< | $(PREPROC) -i $< charmap.txt | $(CC) $(CFLAGS) $(MIRROR_CFLAGS) -x cpp-output -c -o $@.raw.o -
	@$(MIRROR_SECTIONS) game $@.raw.o $@
	@rm -f $@.raw.o

# portable_abi.h is force-included (scaninc cannot see it) and the flags live here.
# The flags can also come from the command line (build options, build_difftest.sh):
# $(FLAGS_STAMP) changes whenever they do, so a reconfigured build directory
# recompiles everything.
FLAGS_STAMP := $(OBJ_DIR)/compile_flags.txt
FLAGS_NOW := $(CC) $(CFLAGS) | $(PLATFORM_CFLAGS)
$(FLAGS_STAMP): FORCE
	@mkdir -p $(@D)
	@if [ "$$(cat $@ 2>/dev/null)" != '$(FLAGS_NOW)' ]; then printf '%s\n' '$(FLAGS_NOW)' > $@; fi
.PHONY: FORCE
FORCE: ;
$(C_OBJS) $(PLATFORM_OBJS): include/gba/portable_abi.h Makefile.native $(FLAGS_STAMP)
$(C_OBJS) $(PLATFORM_OBJS) $(DATA_ASM_OBJS) $(SONG_OBJS) $(MID_OBJS): native/mirror_sections.py ../tools/mirror/elf32.py ../tools/mirror/layout.py
$(DATA_ASM_OBJS) $(SONG_OBJS) $(MID_OBJS): native/as_x86.py

$(C_BUILDDIR)/%.d: $(C_SUBDIR)/%.c
	@$(SCANINC) -M $@ $(INCLUDE_SCANINC_ARGS) -I tools/agbcc/include $<

ifneq ($(NODEP),1)
-include $(addprefix $(OBJ_DIR)/,$(C_SRCS:.c=.d))
endif

# Data .s (pret pipeline; $(AS) converts ARM GAS syntax and assembles for i386)
$(DATA_ASM_BUILDDIR)/%.o: $(DATA_ASM_SUBDIR)/%.s
	@echo "as $<"
	@$(PREPROC) $< charmap.txt | $(CPP) -undef $(INCLUDE_SCANINC_ARGS) - | $(PREPROC) -ie $< charmap.txt | $(AS) $(ASFLAGS) -o $@

$(DATA_ASM_BUILDDIR)/%.d: $(DATA_ASM_SUBDIR)/%.s
	@$(SCANINC) -M $@ $(INCLUDE_SCANINC_ARGS) -I "" $<

ifneq ($(NODEP),1)
-include $(addprefix $(OBJ_DIR)/,$(REGULAR_DATA_ASM_SRCS:.s=.d))
endif

# ---------------------------------------------------------------------------
# Platform (hardware replacements, compiled with the game flags)
PLATFORM_HDRS := $(wildcard $(PLATFORM_DIR)/*.h)
$(PLATFORM_BUILDDIR)/%.o: $(PLATFORM_DIR)/%.c $(PLATFORM_HDRS)
	@echo "cc $<"
	@mkdir -p $(@D)
	@$(CC) $(CPPFLAGS) $(MIRROR_CPPFLAGS) $(PLATFORM_CFLAGS) $(MIRROR_CFLAGS) -MMD -MP -MF $(@:.o=.dep) -c -o $@.raw.o $<
	@$(MIRROR_SECTIONS) platform $@.raw.o $@
	@rm -f $@.raw.o

ifneq ($(NODEP),1)
-include $(PLATFORM_OBJS:.o=.dep)
endif

# ---------------------------------------------------------------------------
# Archives and linker fragment
$(LIBFIRERED): $(GAME_OBJS)
	@echo "ar $@"
	@rm -f $@
	@printf '%s\n' $(abspath $(GAME_OBJS)) > $@.objs
	@$(AR) rcs $@ @$@.objs

$(LIBPLATFORM): $(PLATFORM_OBJS)
	@echo "ar $@"
	@rm -f $@
	@printf '%s\n' $(abspath $(PLATFORM_OBJS)) > $@.objs
	@$(AR) rcs $@ $(PLATFORM_OBJS)

# The mirror layout: place every game RAM variable at its ROM address
# (fails on any ROM RAM symbol without a native counterpart that is not a
# documented gap, and on any game RAM section it cannot place).
$(MIRROR_LD): $(LIBFIRERED) $(LIBPLATFORM) $(ROM_SYMBOLS) ../tools/mirror/gen_ld.py ../tools/mirror/layout.py ../tools/mirror/elf32.py
	@echo "gen_ld $@"
	@$(GEN_LD) --quiet --rom-symbols $(ROM_SYMBOLS) --objs $(LIBFIRERED).objs --objs $(LIBPLATFORM).objs \
	    --obj-root $(OBJ_ROOT) --placement-out $(MIRROR_PLACEMENT) -o $@

# Sanity check of the data conversion: assemble every data file with the ARM
# toolchain and with native/as_x86.py and compare section bytes + relocations.
check-data: $(DATA_ASM_OBJS) $(MID_OBJS)
	$(PYTHON) native/compare_data_objs.py
